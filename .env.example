PORT=4000

# MongoDB Atlas connection string (free tier is fine to start).
# Get one at https://www.mongodb.com/cloud/atlas/register — create a free
# cluster, add a database user, allow your IP (or 0.0.0.0/0 while testing),
# then copy the "Connect your application" URI here.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/msikax

# Any long random string — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# From https://dashboard.paychangu.com -> Settings -> API & Webhooks
PAYCHANGU_SECRET_KEY=sec-test-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYCHANGU_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where your client/index.html is served from, for CORS + PayChangu redirects.
FRONTEND_ORIGIN=http://localhost:5500

# Where THIS backend itself is reachable — used to build the link inside
# verification emails (e.g. https://api.yourdomain.com). Defaults to
# http://localhost:PORT if left blank, which is fine for local testing.
BACKEND_ORIGIN=http://localhost:4000

# --- Email verification (optional while developing) ---
# Leave SMTP_HOST blank and verification links just print to the server
# console instead of emailing anyone — handy for local testing.
# For real sending, Gmail works for free: turn on 2-Step Verification on
# the Google account, then create an "app password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS
# (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=MsikaX <youraddress@gmail.com>
